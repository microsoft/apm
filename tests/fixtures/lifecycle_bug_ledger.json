    {
      "id": "filesystem.open_world_observation",
      "phase": 1,
      "oracle_tier": "open-world",
      "law": "No command may create, change, or remove files outside its declared write set."
    },
    {
      "id": "transaction.failed_command_preserves_state",
      "phase": 1,
      "oracle_tier": "open-world",
      "law": "A command that fails before commit preserves all durable project and user state."
    },
    {
      "id": "ownership.preserve_unowned",
      "phase": 1,
      "oracle_tier": "open-world",
      "law": "Cleanup changes only APM-owned state and preserves user and surviving-package ownership."
    },
    {
      "id": "idempotency.byte_stable",
      "phase": 1,
      "oracle_tier": "open-world",
      "law": "Repeating a converged operation leaves durable bytes unchanged."
    },
    {
      "id": "routing.authorized_targets_only",
      "phase": 1,
      "oracle_tier": "open-world",
      "law": "Only explicitly effective targets receive package primitives and service configuration."
    },
    {
      "id": "source.ref_cache_coherent",
      "phase": 1,
      "oracle_tier": "semantic",
      "law": "Materialized content, resolved references, and cache identity describe the same source revision."
    },
    {
      "id": "portability.byte_deterministic",
      "phase": 0,
      "oracle_tier": "semantic",
      "law": "Equivalent inputs produce portable paths and deterministic bytes across supported platforms."
    },
    {
      "id": "outcome.status_matches_state",
      "phase": 1,
      "oracle_tier": "outcome",
      "law": "Exit status and diagnostics truthfully describe the durable outcome."
    },
    {
      "id": "cache.successful_reads_refresh_recency",
      "phase": 0,
      "oracle_tier": "outcome",
      "law": "Successful fresh HTTP cache reads protect entries from eviction without extending response TTL or causing a refetch."
    },
    {
      "id": "auth.credentials_isolated",
      "phase": 0,
      "oracle_tier": "outcome",
      "law": "Credentials remain scoped to their intended host and never enter persisted URLs or output."
    }
  ],
