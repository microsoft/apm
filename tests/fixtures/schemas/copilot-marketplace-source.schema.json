{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "APM-owned test subset derived from GitHub Copilot CLI plugin-source-types documentation, retrieved 2026-10-15. Not an official upstream schema or OpenAPM specification. https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-plugin-reference#plugin-source-types",
  "oneOf": [
    {"type": "string", "minLength": 1},
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "repo"],
      "properties": {
        "source": {"const": "github"},
        "repo": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "ref": {"type": "string", "minLength": 1},
        "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url"],
      "properties": {
        "source": {"const": "url"},
        "url": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "path": {"type": "string", "minLength": 1}
      }
    }
  ]
}
