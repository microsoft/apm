        "tests/quality/taxonomy_inventory_plugin.py",
        "tests/quality/test_test_taxonomy.py"
      ],
      "guards": ["contracts-tests-taxonomy-classification"]
    },
    {
      "id": "runtime-descriptors",
      "decision": "Runtime descriptors",
      "owner": "runtime/registry.py",
      "selectors": ["src/apm_cli/runtime/registry.py"],
      "guards": ["registry-delegation-runtime-descriptors"]
    },
    {
      "id": "user-facing-output-diagnostics",
      "decision": "User-facing output / diagnostics",
      "owner": "CommandLogger / console owner",
      "selectors": [
        "src/apm_cli/core/command_logger.py",
        "src/apm_cli/utils/console.py"
      ],
      "guards": ["registry-delegation-output-diagnostics"]
    },
    {
      "id": "compiled-output-writes",
      "decision": "Compiled-output writes (atomic)",
      "owner": "CompiledOutputWriter",
      "selectors": ["src/apm_cli/compilation/output_writer.py"],
      "guards": ["registry-delegation-compiled-output-writes"]
    },
    {
      "id": "distributed-agents-output-preparation",
      "decision": "Agent root-context output eligibility and content preparation",
      "owner": "compilation/agents_compiler.py with compilation/root_context_protection.py",
      "selectors": [
        "src/apm_cli/compilation/agents_compiler.py",
        "src/apm_cli/compilation/root_context_protection.py"
      ],
      "guards": [
        "contracts-tooling-distributed-agents-output",
        "contracts-tooling-root-context-write-eligibility"
      ]
    },
    {
      "id": "compile-nested-git-boundary",
      "decision": "Compile traversal and nested Git repository boundary",
      "owner": "compilation/inventory.py (CompileInventory)",
      "selectors": ["src/apm_cli/compilation/inventory.py"],
      "guards": ["contracts-tooling-compile-inventory"]
    },
    {
      "id": "bootstrap-project-name",
      "decision": "Bootstrap project-name validation and fallback",
      "owner": "core/project_name.py (resolve_bootstrap_project_name)",
      "selectors": ["src/apm_cli/core/project_name.py"],
      "guards": ["registry-delegation-bootstrap-project-name"]
    }
