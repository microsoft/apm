      "guards": ["registry-delegation-install-target-selection"]
    },
    {
      "id": "behavioral-test-taxonomy-classification",
      "decision": "Behavioral test taxonomy classification",
      "owner": "module-level pytestmark (taxonomy inventory verifies)",
