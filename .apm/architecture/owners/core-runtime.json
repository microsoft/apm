{
  "version": 1,
  "owners": [
    {
      "id": "accepted-target-vocabulary",
      "decision": "Accepted target vocabulary",
      "owner": "core/target_catalog.py",
      "selectors": ["src/apm_cli/core/target_catalog.py"],
      "guards": ["registry-delegation-target-vocabulary"]
    },
    {
      "id": "manifest-target-declaration",
      "decision": "Package manifest target declaration: target:/targets: spelling, token validation, legacy all, the views readers consume, the deprecated target: and vscode-alias warnings, and the one target rewrite mapping (rewrite_target_names) that the target: warning shows and apm init re-init writes",
      "owner": "models/manifest_targets.py (ManifestTargetDeclaration, targets_replacement, rewrite_target_names, verify_rewritten_manifest, read_manifest_target_declaration, _warn_deprecated_manifest_keys) via models/apm_package.py (APMPackage.target_declaration, package_target_declaration); used by the apm init re-init (commands/init.py, commands/_helpers.py)",
      "selectors": ["src/apm_cli/models/manifest_targets.py"],
      "guards": ["registry-delegation-manifest-target-declaration"]
    },
    {
      "id": "effective-install-target-selection",
      "decision": "Effective target selection and its compilation-target policy projection",
      "owner": "core/target_detection.py (EffectiveTargetDecision.canonical_targets, canonical_policy_target_names)",
      "selectors": ["src/apm_cli/core/target_detection.py"],
      "guards": [
        "registry-delegation-install-target-selection",
        "registry-delegation-audit-target-selection",
        "registry-delegation-policy-target-projection"
      ]
    },
    {
      "id": "behavioral-test-taxonomy-classification",
      "decision": "Behavioral test taxonomy classification",
      "owner": "module-level pytestmark (taxonomy inventory verifies)",
      "selectors": [
        "tests/quality/taxonomy_inventory_plugin.py",
        "tests/quality/test_test_taxonomy.py"
      ],
      "guards": ["contracts-tests-taxonomy-classification"]
    },
    {
      "id": "runtime-descriptors",
      "decision": "Runtime descriptors",
      "owner": "runtime/registry.py",
      "selectors": ["src/apm_cli/runtime/registry.py"],
      "guards": ["registry-delegation-runtime-descriptors"]
    },
    {
      "id": "user-facing-output-diagnostics",
      "decision": "User-facing output / diagnostics, including MCP client adapters and the safe MCP installer, which emit through CommandLogger",
      "owner": "core/command_logger.py (CommandLogger, library_output, library_logger)",
      "selectors": ["src/apm_cli/core/command_logger.py"],
      "guards": ["registry-delegation-output-diagnostics"]
    },
    {
      "id": "console-construction",
      "decision": "Rich Console and Table construction: every console and table comes from one ASCII-rendering factory",
      "owner": "utils/console.py (new_console, new_table, _get_console)",
      "selectors": ["src/apm_cli/utils/console.py"],
      "guards": ["registry-delegation-console-construction"]
    },
    {
      "id": "experimental-flag-registry",
      "decision": "Experimental flags: every registered flag has a runtime reader; experimental-only notices stay verbose; GA help is not marked experimental",
      "owner": "core/experimental.py (FLAGS, is_enabled)",
      "selectors": ["src/apm_cli/core/experimental.py"],
      "guards": ["registry-delegation-experimental-flags"]
    },
    {
      "id": "compiled-output-writes",
      "decision": "Compiled-output writes (atomic)",
      "owner": "CompiledOutputWriter",
      "selectors": ["src/apm_cli/compilation/output_writer.py"],
      "guards": ["registry-delegation-compiled-output-writes"]
    },
    {
      "id": "distributed-agents-output-preparation",
      "decision": "Agent root-context output eligibility, user-root replacement and redundant-root cleanup, and content preparation",
      "owner": "compilation/agents_compiler.py with compilation/root_context_protection.py and compilation/build_id.py",
      "selectors": [
        "src/apm_cli/compilation/agents_compiler.py",
        "src/apm_cli/compilation/root_context_protection.py",
        "src/apm_cli/compilation/user_root_context.py",
        "src/apm_cli/compilation/build_id.py"
      ],
      "guards": [
        "contracts-tooling-distributed-agents-output",
        "contracts-tooling-root-context-write-eligibility",
        "registry-delegation-build-id-verification"
      ]
    },
    {
      "id": "compile-nested-git-boundary",
      "decision": "Compile traversal and nested Git repository boundary",
      "owner": "compilation/inventory.py (CompileInventory)",
      "selectors": ["src/apm_cli/compilation/inventory.py"],
      "guards": ["contracts-tooling-compile-inventory"]
    },
    {
      "id": "bootstrap-project-name",
      "decision": "Bootstrap project-name validation and fallback",
      "owner": "core/project_name.py (resolve_bootstrap_project_name)",
      "selectors": ["src/apm_cli/core/project_name.py"],
      "guards": ["registry-delegation-bootstrap-project-name"]
    },
    {
      "id": "manifest-bootstrap-writer",
      "decision": "Minimal apm.yml bootstrap config and writer shared by apm init, install auto-bootstrap and install --mcp, so the install layer never imports the commands layer",
      "owner": "models/manifest_bootstrap.py (bootstrap_config, write_minimal_manifest); commands/_helpers.py re-exports the historical names",
      "selectors": ["src/apm_cli/models/manifest_bootstrap.py"],
      "guards": ["registry-delegation-install-layering"]
    },
    {
      "id": "user-invocable-resolution",
      "decision": "Agent user-invocable resolution from frontmatter, including the visibility: internal alias",
      "owner": "primitives/models.py (resolve_user_invocable)",
      "selectors": [
        "src/apm_cli/primitives/models.py",
        "src/apm_cli/primitives/parser.py",
        "src/apm_cli/integration/agent_integrator.py"
      ],
      "guards": ["registry-delegation-user-invocable-resolution"]
    },
    {
      "id": "cli-version-rendering",
      "decision": "CLI version rendering and lightweight entrypoint delegation",
      "owner": "version_output.py (print_version) + entrypoint.py (main)",
      "selectors": [
        "src/apm_cli/version_output.py",
        "src/apm_cli/entrypoint.py"
      ],
      "guards": ["registry-delegation-version-rendering"]
    },
    {
      "id": "apm-home-resolution",
      "decision": "APM-owned user metadata root",
      "owner": "core/scope.py (get_apm_home)",
      "selectors": ["src/apm_cli/core/scope.py"],
      "guards": ["registry-delegation-apm-home-resolution", "install-deployment-bundle-user-scope-root"]
    },
    {
      "id": "harness-user-root-resolution",
      "decision": "Harness user-root variables (COPILOT_HOME, CODEX_HOME, CLAUDE_CONFIG_DIR, HERMES_HOME): defaults, absolute-only values and the selected user root",
      "owner": "integration/targets.py (USER_ROOT_VARIABLES, configured_user_root, resolve_user_root)",
      "selectors": [
        "src/apm_cli/integration/canvas_integrator.py",
        "src/apm_cli/commands/uninstall/profile_scope.py"
      ],
      "guards": ["registry-delegation-harness-user-root-resolution"]
    },
    {
      "id": "process-interrupt-signals",
      "decision": "SIGTERM takes the same interrupt (Ctrl+C) path as SIGINT; a second SIGTERM terminates",
      "owner": "cli.py (main, _route_sigterm_to_interrupt)",
      "selectors": ["src/apm_cli/cli.py"],
      "guards": ["registry-delegation-process-interrupt-signals"]
    }
  ]
}
