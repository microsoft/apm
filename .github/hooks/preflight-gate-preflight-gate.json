{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash|Bash|write_bash|shell|powershell|pwsh|run_in_terminal|runInTerminal|.*create_pull_request|.*update_pull_request",
        "bash": "p=\".github/hooks/scripts/preflight-gate/.apm/hooks/scripts/gate-launcher.sh\"; [ -f \"$p\" ] || p=\"$(git rev-parse --show-toplevel 2>/dev/null)/$p\"; bash \"$p\" || true; exit 0",
        "powershell": "exit 0",
        "timeoutSec": 15
      }
    ]
  }
}
