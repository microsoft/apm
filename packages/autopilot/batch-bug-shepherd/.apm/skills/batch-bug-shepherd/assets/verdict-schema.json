{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "batch-bug-shepherd-verdict-schema.json",
  "title": "batch-bug-shepherd subagent return shapes",
  "description": "BBS-owned triage, strategic-alignment, and fix returns. Driver and conflict-resolution returns use shepherd-driver assets/completion-schema.json. Validate every return. Malformed triage/alignment may retry once; repeated failures become UNCLEAR (triage) or blocked (alignment), never permission. Malformed fix returns block before consuming PR fields.",
  "oneOf": [
    { "$ref": "#/definitions/triage_return" },
    { "$ref": "#/definitions/strategic_alignment_return" },
    { "$ref": "#/definitions/fix_return" }
  ],
  "definitions": {
    "triage_return": {
      "type": "object",
      "required": ["kind", "issue", "verdict", "summary"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "triage" },
        "issue": { "type": "integer", "minimum": 1 },
        "verdict": {
          "type": "string",
          "enum": ["LEGIT", "UNCLEAR", "FIXED-AT-HEAD", "NOT-A-BUG"]
        },
        "summary": { "type": "string", "maxLength": 400 },
        "repro_steps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Smallest possible reproduction; required when verdict=LEGIT."
        },
        "evidence": {
          "type": "string",
          "description": "Command output, file paths, or commit refs that justify the verdict."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "LEGIT" } } },
          "then": { "required": ["repro_steps"] }
        }
      ]
    },
    "strategic_alignment_return": {
      "type": "object",
      "required": ["kind", "issue", "verdict", "cited_principle", "rationale"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "strategic-alignment" },
        "issue": { "type": "integer", "minimum": 1 },
        "verdict": {
          "type": "string",
          "enum": ["aligned", "aligned-with-reservations", "out-of-scope", "wrong-direction"]
        },
        "cited_principle": {
          "type": "string",
          "maxLength": 400,
          "minLength": 1,
          "description": "Verbatim section heading or short sentence from PRINCIPLES.md that grounds the verdict. Infrastructure errors cannot stand in for a citation or authorize implementation; unavailable evidence blocks for human review."
        },
        "rationale": {
          "type": "string",
          "maxLength": 500,
          "description": "1-3 sentences explaining the verdict in CEO voice. References the cited principle by name."
        },
        "reservations": {
          "type": "array",
          "items": { "type": "string", "maxLength": 200 },
          "description": "Required when verdict=aligned-with-reservations. Each entry is one specific concern downstream phases (panel / completion) must surface in their review prose. Omitted for other verdicts."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "aligned-with-reservations" } } },
          "then": { "required": ["reservations"] }
        }
      ]
    },
    "fix_return": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "issue", "status", "pr", "branch"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "fix" },
            "issue": { "type": "integer", "minimum": 1 },
            "status": { "const": "pr-opened" },
            "pr": { "type": "integer", "minimum": 1 },
            "branch": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "issue", "status", "reason"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "fix" },
            "issue": { "type": "integer", "minimum": 1 },
            "status": { "const": "blocked" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      ]
    }
  }
}
